# Database Configuration
MONGODB_URI=mongodb+srv://nafishaaslam2_db_user:Staz61N7c4G2IdBa@cluster0.maupq3l.mongodb.net/?appName=Cluster0
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
ACCESS_TOKEN_SECRET=your-access-token-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=10d

# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=*

# MSG91 SMS Service Configuration
# Get this from your MSG91 dashboard: https://control.msg91.com/user/index.php#api
MSG91_AUTH_KEY=your_msg91_auth_key_here

# MSG91 Sender ID (Required)
# This should be approved by MSG91 for your account
# For testing, you can use 'TXTLCL' (but delivery may be limited)
MSG91_SENDER_ID=TXTLCL

# MSG91 Template/Flow ID (Optional but recommended for India DLT compliance)
# Create a template in MSG91 dashboard for better delivery rates
MSG91_TEMPLATE_ID=your_template_id_here

# UPI Payment Configuration (Required)
# Your UPI ID for payment links
UPI_ID=your_upi_id@bank

# Debug Mode (Optional)
# Set to 'true' to enable detailed logging
SMS_DEBUG=true

# Cloudinary Configuration (Optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Example values (replace with your actual values):
# MONGODB_URI=mongodb+srv://myuser:mypassword@cluster0.y3ypnsp.mongodb.net
# MSG91_AUTH_KEY=1234567890ABCDEF1234567890ABCDEF
# MSG91_SENDER_ID=MYAPP
# MSG91_TEMPLATE_ID=5f8c9d2e1a2b3c4d5e6f7890
# UPI_ID=merchant@paytm
# JWT_SECRET=my-super-secret-jwt-key-change-this-in-production
